generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  displayName       String
  clearance         Int
  badgeId           String
  isAdministrator   Boolean            @default(false)
  // Mapped to legacy column name so live SQLite data is preserved.
  containmentAccess Boolean            @default(false) @map("deepAccess")
  isSystem          Boolean            @default(false)
  deactivated       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  clearanceRequests ClearanceRequest[]
}

model ClearanceRequest {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username           String
  requestedClearance Int
  // Mapped to legacy column name so live SQLite data is preserved.
  requestContainmentAccess Boolean  @default(false) @map("requestDeepAccess")
  name               String
  rank               String
  job                String
  notes              String
  submittedAt        DateTime @default(now())

  @@index([userId])
  @@index([submittedAt])
}

model PersonnelRecord {
  recordUid     String   @id
  designation   String
  name          String
  aliasesJson   String
  picture       String?
  fieldsJson    String
  createdBy     String?
  createdAt     DateTime @default(now())
  isUserCreated Boolean  @default(false)
  isBuiltin     Boolean  @default(false)
}

model PendingPersonnelSubmission {
  requestId   String   @id @default(uuid())
  recordJson  String
  submittedBy String
  submittedAt DateTime @default(now())
}
